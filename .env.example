# API token for /api/* endpoints (leave empty to disable auth in dev)
ROLLARR_API_TOKEN=

# Sonarr connection
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Plex connection
PLEX_URL=http://plex:32400
PLEX_TOKEN=
# Optional: path to Plex SQLite DB for "Mark as Watched" detection
PLEX_DB_PATH=

# Webhook secret from Seerr/Jellyseerr (leave empty to skip verification)
SEERR_WEBHOOK_SECRET=

# Server port (default: 3001)
PORT=3001

# SQLite database path (default: rollarr.db)
DB_PATH=rollarr.db
